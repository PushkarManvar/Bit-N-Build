{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/00_START_HERE.md",
    "docs/03_TECHNICAL_ARCHITECTURE.md",
    "docs/04_DATA_IDENTITY_AND_RULES.md",
    "docs/05_API_CONTRACT.md"
  ],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "ask",
      "pwd*": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git checkout -b*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "npm install*": "allow",
      "npm ci*": "allow",
      "npm run*": "allow",
      "python*": "allow",
      "pip install*": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "docker compose config*": "allow",
      "docker compose build*": "allow",
      "docker compose up*": "allow",
      "docker compose run*": "allow",
      "docker compose logs*": "allow",
      "docker compose ps*": "allow",
      "docker compose down": "allow",
      "make *": "allow",
      "git push*": "ask",
      "sudo *": "ask",
      "docker compose down --volumes*": "ask",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
